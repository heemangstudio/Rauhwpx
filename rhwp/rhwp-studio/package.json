{
  "name": "rhwp-studio",
  "version": "0.8.2",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "agent": "node ../rhwp-agent/server.mjs",
    "subsecond:install": "cargo install dioxus-cli --version 0.7.9 --locked --root ../target/dioxus-cli",
    "subsecond:serve": "cd .. && target/dioxus-cli/bin/dx serve --web --package rhwp-subsecond --features subsecond-dev --hot-patch --port 7711 --addr 127.0.0.1 --open false --interactive false --inject-loading-scripts false",
    "subsecond:sync": "mkdir -p ../target/rhwp-subsecond-vite && cp ../target/dx/rhwp-subsecond/debug/web/public/wasm/rhwp-subsecond.js ../target/dx/rhwp-subsecond/debug/web/public/wasm/rhwp-subsecond_bg.wasm ../target/rhwp-subsecond-vite/",
    "dev:subsecond": "npm run subsecond:sync && RHWP_SUBSECOND=1 vite",
    "generate:agent-edit-capabilities": "node scripts/generate-agent-edit-capabilities.mjs",
    "build": "npm run generate:agent-edit-capabilities && tsc && vite build",
    "preview": "vite preview",
    "lint:css-tokens": "node scripts/check-css-tokens.mjs",
    "test": "npm run generate:agent-edit-capabilities && node scripts/run-tests.mjs unit",
    "e2e:smoke": "node e2e/smoke/run.mjs",
    "e2e:background-sessions": "node e2e/background-agent-sessions.test.mjs --mode=headless",
    "e2e:worktrees": "node e2e/worktree-lifecycle.test.mjs --mode=headless",
    "e2e:chat-follows-document": "node e2e/chat-follows-document.test.mjs --mode=headless",
    "bench:agent-tools": "node bench/agent-tool-bench.mjs",
    "bench:agent-tool-concurrency": "node bench/agent-tool-concurrency-bench.mjs",
    "bench:live-agent-quota": "node bench/agent-claude-live-bench.mjs",
    "bench:live-agent-suite-quota": "node bench/agent-live-suite.mjs",
    "bench:typing-latency": "node bench/typing-latency-bench.mjs",
    "bench:typing-latency-bigdoc": "node bench/typing-latency-bigdoc.mjs",
    "bench:chat-stream": "node bench/chat-stream-bench.mjs",
    "bench:preview-frame": "node bench/preview-frame-bench.mjs",
    "bench:typeset-line-width": "node bench/typeset-line-width-bench.mjs",
    "bench:long-document-image-cache": "node bench/long-document-image-cache.mjs",
    "bench:canvaskit-image-cache": "node bench/canvaskit-image-cache-budget.mjs",
    "bench:agent-overlay": "node bench/agent-overlay-performance.mjs",
    "test:browser": "node scripts/run-tests.mjs browser",
    "dev:sidebar": "vite --config vite.sidebar.config.ts",
    "build:sidebar": "vite build --config vite.sidebar.config.ts",
    "test:sidebar": "node sidebar-preview/check.mjs",
    "test:sidebar:skills": "node sidebar-preview/skills.check.mjs",
    "test:sidebar:skill-editor": "node sidebar-preview/skill-editor.check.mjs",
    "test:sidebar:audit": "node sidebar-preview/audit.check.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.2",
    "pixelmatch": "^7.1.0",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-window": "^7.4.1"
  },
  "overrides": {
    "serialize-javascript": "7.0.5"
  },
  "dependencies": {
    "@noble/hashes": "^2.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "canvaskit-wasm": "^0.41.1",
    "katex": "^0.16.47"
  }
}
