[Unit]
Description=Stop this boat sandbox once Rauhwpx Cloud has been idle
After=network-online.target rauhwpx-cloud.service
ConditionPathExists=/etc/rauhwpx-boat.env

[Service]
Type=oneshot
ExecStart=/opt/rauhwpx-cloud/current/install/boat-idle.sh
SyslogIdentifier=rauhwpx-boat-idle
TimeoutStartSec=5min
Nice=10
